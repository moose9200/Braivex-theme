{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %}
  Product detail hero. The homepage product row promoted to an h1: copy on
  one side, the same animated HTML/CSS mockup on the other, feature chips
  that light the matching mockup region (braivex.js initProductRows). The
  chips link to an anchor further down the page.
{% endcomment %}
<section class="bvx-pagehero bvx-pagehero--product">
  <div class="bvx-pagehero__inner">
    <article class="bvx-product bvx-product--hero bvx-reveal{% if section.settings.reverse %} bvx-product--reverse{% endif %}" data-bvx-product>
      <div class="bvx-product__copy">
        {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1 class="bvx-product__name">{{ section.settings.heading | default: page.title }}{% if section.settings.badge != blank %} <span class="bvx-product__badge">{{ section.settings.badge }}</span>{% endif %}</h1>
        {% if section.settings.lede != blank %}<p class="bvx-product__headline">{{ section.settings.lede | newline_to_br }}</p>{% endif %}
        {% if section.settings.metric != blank %}
          <p class="bvx-product__metric"><span class="bvx-product__metric-dot" aria-hidden="true"></span>{{ section.settings.metric }}</p>
        {% endif %}

        <ul class="bvx-product__features" aria-label="{{ section.settings.heading | default: page.title | escape }} capabilities">
          {% for i in (1..4) %}
            {% assign lkey = 'feature_' | append: i | append: '_label' %}
            {% assign rkey = 'feature_' | append: i | append: '_region' %}
            {% if section.settings[lkey] != blank %}
              <li><a class="bvx-chip" href="{{ section.settings.chips_link | default: '#what' }}"{% if section.settings.chips_link contains '://' %} target="_blank" rel="noopener"{% endif %} data-region="{{ section.settings[rkey] }}">{{ section.settings[lkey] }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>

        <div class="bvx-actions">
          {% if section.settings.cta_primary_label != blank %}
            <a class="bvx-btn bvx-btn--primary" href="{{ section.settings.cta_primary_link | default: '/pages/contact' }}"{% if section.settings.cta_primary_link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.cta_primary_label }}</a>
          {% endif %}
          {% if section.settings.cta_secondary_label != blank %}
            <a class="bvx-link" href="{{ section.settings.cta_secondary_link | default: '#what' }}"{% if section.settings.cta_secondary_link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.cta_secondary_label }} <span class="bvx-link__arrow" aria-hidden="true">&rarr;</span></a>
          {% endif %}
        </div>
      </div>

      <div class="bvx-product__visual">
        {% assign mock_name = section.settings.heading | default: page.title %}
        {% case section.settings.mock %}
          {% when 'loculens' %}{% render 'product-mock-loculens', name: mock_name %}
          {% when 'hiresieve' %}{% render 'product-mock-hiresieve', name: mock_name %}
          {% when 'briefsieve' %}{% render 'product-mock-briefsieve', name: mock_name %}
          {% when 'housieve' %}{% render 'product-mock-housieve', name: mock_name %}
          {% when 'voicesieve' %}{% render 'product-mock-voicesieve', name: mock_name %}
        {% endcase %}
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Braivex product hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Product name (h1)", "info": "Falls back to the page title" },
    { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. In development, Early access. Leave blank for a live product." },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "metric", "label": "Proof line", "info": "One real fact. Leave blank rather than invent one." },
    {
      "type": "select", "id": "mock", "label": "Mockup",
      "options": [
        { "value": "loculens", "label": "Loculens dashboard" },
        { "value": "hiresieve", "label": "HireSieve shortlist" },
        { "value": "briefsieve", "label": "BriefSieve brief" },
        { "value": "housieve", "label": "Housieve feed" },
        { "value": "voicesieve", "label": "VoiceSieve console" }
      ],
      "default": "loculens"
    },
    { "type": "checkbox", "id": "reverse", "label": "Mockup on the left", "default": false },
    { "type": "header", "content": "Feature chips (hover lights the mockup)" },
    { "type": "text", "id": "chips_link", "label": "Chips link to", "default": "#what" },
    { "type": "text", "id": "feature_1_label", "label": "Feature 1" },
    { "type": "text", "id": "feature_1_region", "label": "Region 1", "info": "loculens: branches, sentiment, team, reply · hiresieve: evidence, score, flag, cost · briefsieve: brief, kpis, channels, guru · housieve: ask, sources, listings, alert · voicesieve: mine, inbound, outbound, handoff" },
    { "type": "text", "id": "feature_2_label", "label": "Feature 2" },
    { "type": "text", "id": "feature_2_region", "label": "Region 2" },
    { "type": "text", "id": "feature_3_label", "label": "Feature 3" },
    { "type": "text", "id": "feature_3_region", "label": "Region 3" },
    { "type": "text", "id": "feature_4_label", "label": "Feature 4" },
    { "type": "text", "id": "feature_4_region", "label": "Region 4" },
    { "type": "header", "content": "Calls to action" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button", "default": "Book a demo" },
    { "type": "text", "id": "cta_primary_link", "label": "Primary link", "default": "/pages/contact" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary link text" },
    { "type": "text", "id": "cta_secondary_link", "label": "Secondary link", "default": "#what" }
  ],
  "presets": [{ "name": "Braivex product hero" }]
}
{% endschema %}
