{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Article — hairline hero from the article itself, then editorial body. {% endcomment %}
<article>
  <section class="bvx-pagehero">
    <div class="bvx-pagehero__inner">
      <p class="bvx__eyebrow">{{ article.published_at | date: '%d %B %Y' }}</p>
      <h1 class="bvx-pagehero__h1">{{ article.title }}</h1>
      {% if article.excerpt != blank %}<p class="bvx-pagehero__lede">{{ article.excerpt | strip_html }}</p>{% endif %}
    </div>
  </section>

  <section class="bvx">
    <div class="bvx__inner bvx-article">
      <div class="bvx-prose bvx-reveal">
        {{ article.content }}
      </div>

      {%- comment -%}
        The rail builds itself from the headings in .bvx-prose, so writers never
        maintain a second copy of the outline. It hides itself when a post has
        fewer than two headings.
      {%- endcomment -%}
      {% if section.settings.show_rail %}
        <aside class="bvx-rail"
          data-bvx-rail
          data-bvx-rail-target=".bvx-prose"
          data-bvx-rail-levels="{{ section.settings.rail_levels }}"
          data-bvx-rail-label="{{ section.settings.rail_label | escape }}"
          data-bvx-rail-time="{% if section.settings.rail_time %}true{% else %}false{% endif %}"
          hidden></aside>
      {% endif %}
    </div>
  </section>
</article>

{% schema %}
{
  "name": "Braivex article",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Reading rail"
    },
    {
      "type": "checkbox",
      "id": "show_rail",
      "label": "Show reading rail",
      "info": "Sticky outline in the right column. Appears on screens 1080px and wider; narrower screens get a progress bar under the header.",
      "default": true
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Rail label",
      "default": "Signal path"
    },
    {
      "type": "select",
      "id": "rail_levels",
      "label": "Include headings",
      "options": [
        { "value": "h2", "label": "Main sections only (H2)" },
        { "value": "h2h3", "label": "Sections and subsections (H2 + H3)" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "rail_time",
      "label": "Show reading time remaining",
      "default": true
    }
  ],
  "presets": [{ "name": "Braivex article" }]
}
{% endschema %}
