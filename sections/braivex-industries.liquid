{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Sectors and verticals — 8 cells in a hairline-divided grid. {% endcomment %}
<section class="bvx" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede }}</p>{% endif %}
    </div>

    <div class="bvx-grid bvx-grid--4 bvx-reveal">
      {% for block in section.blocks %}
        <article class="bvx-cell" {{ block.shopify_attributes }}>
          <h3 class="bvx-cell__title">{{ block.settings.title }}</h3>
          <p class="bvx-cell__desc">{{ block.settings.desc }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Braivex industries",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "industries" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sectors and verticals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The architecture of industry intelligence." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Agentic applications engineered for the compliance requirements, workflow complexity and customer expectations of each vertical." }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "desc", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex industries",
      "blocks": [
        { "type": "industry", "settings": { "title": "Banking & Finance", "desc": "Regulation-aware AI that coordinates self-service and live support on audit-ready shared context." } },
        { "type": "industry", "settings": { "title": "Healthcare", "desc": "24/7 HIPAA-compliant patient care with intelligent triage and less load on clinical staff." } },
        { "type": "industry", "settings": { "title": "Retail & Consumer", "desc": "Personalised discovery and frictionless support that convert and retain." } },
        { "type": "industry", "settings": { "title": "Telecom & Media", "desc": "High-volume interactions handled and resolved without losing human empathy." } },
        { "type": "industry", "settings": { "title": "Enterprise Operations", "desc": "Repetitive internal workflows automated so teams can hold the high-leverage work." } },
        { "type": "industry", "settings": { "title": "IT Managed Services", "desc": "Incidents resolved faster by agents that understand your stack and escalate with precision." } },
        { "type": "industry", "settings": { "title": "HR & People Ops", "desc": "Policy lookups and onboarding automated to end people-team fatigue." } },
        { "type": "industry", "settings": { "title": "Talent Acquisition", "desc": "Pipelines accelerated by agents that screen and engage top-tier talent." } }
      ]
    }
  ]
}
{% endschema %}
