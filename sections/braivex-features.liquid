<style>
  .braivex-features-section {
    background-color: #000000;
    padding: 120px 20px;
    color: #fff;
    position: relative;
    z-index: 10;
    overflow: hidden;
  }
  
  .braivex-features-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,240,255,0.3), transparent);
  }

  .braivex-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .braivex-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px auto;
  }

  .braivex-section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 20px;
    color: #ffffff;
    letter-spacing: -1px;
  }
  
  .braivex-section-subtitle {
    font-size: 1.1rem;
    color: #888;
    line-height: 1.6;
  }

  .braivex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    perspective: 1500px;
  }

  /* 3D Glassmorphism Cards */
  .braivex-card {
    position: relative;
    border-radius: 20px;
    padding: 1px; /* for gradient border */
    background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.01));
    transition: transform 0.1s;
    transform-style: preserve-3d;
  }
  
  .braivex-card-inner {
    background: rgba(10, 10, 10, 0.8);
    border-radius: 20px;
    padding: 40px;
    height: 100%;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
    transform: translateZ(20px); /* 3D pop effect */
  }

  .braivex-card-glow {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at center, rgba(0, 240, 255, 0.4) 0%, transparent 70%);
    opacity: 0;
    z-index: 1;
    transition: opacity 0.3s ease;
    border-radius: 20px;
    pointer-events: none;
  }
  
  .braivex-card:hover .braivex-card-glow {
    opacity: 1;
  }

  .braivex-card-icon {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: rgba(0, 240, 255, 0.05);
    border: 1px solid rgba(0, 240, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.1);
  }

  .braivex-card-title {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 15px;
    color: #fff;
    letter-spacing: -0.5px;
  }

  .braivex-card-desc {
    color: #999;
    line-height: 1.7;
    margin-bottom: 30px;
    flex-grow: 1;
  }

  .braivex-card-link {
    color: #00f0ff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .braivex-card-link .arrow {
    margin-left: 8px;
    transition: transform 0.3s ease;
  }
  
  .braivex-card-link:hover .arrow {
    transform: translateX(5px);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // GSAP Scroll Reveal for Cards
  gsap.from(".feature-card", {
    scrollTrigger: {
      trigger: ".braivex-features-section",
      start: "top 80%",
    },
    y: 100,
    opacity: 0,
    duration: 1,
    stagger: 0.15,
    ease: "power3.out"
  });

  // Vanilla JS 3D Tilt Effect
  const cards = document.querySelectorAll('.feature-card');
  
  cards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      const rotateX = ((y - centerY) / centerY) * -10; // Max 10 deg
      const rotateY = ((x - centerX) / centerX) * 10;
      
      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      
      // Update glow position
      const glow = card.querySelector('.braivex-card-glow');
      glow.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(0, 240, 255, 0.15) 0%, transparent 60%)`;
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      card.querySelector('.braivex-card-glow').style.background = `radial-gradient(circle at center, rgba(0, 240, 255, 0.4) 0%, transparent 70%)`;
    });
  });
});
</script>

