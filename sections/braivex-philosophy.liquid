{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Philosophy — statement, argument, pull quote. {% endcomment %}
<section class="bvx" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx-split bvx-reveal">
      <div>
        <div class="bvx__head" style="margin-bottom: 28px;">
          {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
          {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
        </div>
        {% if section.settings.cta_1_label != blank %}
          <div class="bvx-actions">
            <a class="bvx-btn bvx-btn--primary" {% if section.settings.cta_1_link != blank %}href="{{ section.settings.cta_1_link }}"{% endif %}>{{ section.settings.cta_1_label }}</a>
            {% if section.settings.cta_2_label != blank %}
              <a class="bvx-btn bvx-btn--ghost" {% if section.settings.cta_2_link != blank %}href="{{ section.settings.cta_2_link }}"{% endif %}>{{ section.settings.cta_2_label }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
      <div class="bvx-split__body">
        {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
        {% if section.settings.quote != blank %}
          <blockquote class="bvx-quote">
            <p class="bvx-quote__text">{{ section.settings.quote }}</p>
            {% if section.settings.quote_by != blank %}<span class="bvx-quote__by">{{ section.settings.quote_by }}</span>{% endif %}
          </blockquote>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Braivex philosophy",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "philosophy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deliberate partnerships. Measurable outcomes." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Braivex does not work with everyone, and that is deliberate. When we partner with a brand we bring the full weight of the platform, the expertise and the commitment. Every integration is built to compound in value." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The best AI is not the most complex, it is the most purposeful." },
    { "type": "text", "id": "quote_by", "label": "Attribution", "default": "Braivex product philosophy" },
    { "type": "text", "id": "cta_1_label", "label": "Primary button", "default": "Start Your Journey" },
    { "type": "url", "id": "cta_1_link", "label": "Primary link", "default": "/pages/contact" },
    { "type": "text", "id": "cta_2_label", "label": "Secondary button", "default": "Explore Client Stories" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary link", "default": "/#insights" }
  ],
  "presets": [{ "name": "Braivex philosophy" }]
}
{% endschema %}
