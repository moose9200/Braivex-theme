{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Reusable inner-page hero. Falls back to the page title. {% endcomment %}
<section class="bvx-pagehero">
  <div class="bvx-pagehero__inner">
    {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="bvx-pagehero__h1">{{ section.settings.heading }}</h1>
    {% else %}
      <h1 class="bvx-pagehero__h1">{{ page.title }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}<p class="bvx-pagehero__lede">{{ section.settings.lede }}</p>{% endif %}
    {% if section.settings.cta_label != blank %}
      <div class="bvx-actions" style="margin-top: 34px;">
        <a class="bvx-btn bvx-btn--primary" {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}>{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Braivex page hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Braivex page hero" }]
}
{% endschema %}
