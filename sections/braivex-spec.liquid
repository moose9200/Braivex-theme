{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Reusable spec sheet for a single solution or capability page. {% endcomment %}
<section class="bvx bvx--panel">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede }}</p>{% endif %}
    </div>

    <div class="bvx-grid bvx-grid--2 bvx-reveal">
      {% for block in section.blocks %}
        <div class="bvx-cell" style="min-height:0;" {{ block.shopify_attributes }}>
          <span class="bvx-cell__kicker">{{ block.settings.label }}</span>
          <p class="bvx-cell__desc" style="flex-grow:0;">{{ block.settings.value }}</p>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="bvx-actions bvx-reveal" style="margin-top: 48px;">
        <a class="bvx-btn bvx-btn--primary" {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}>{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Braivex spec sheet",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Specification" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What ships with this module." },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Request this module" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "textarea", "id": "value", "label": "Value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex spec sheet",
      "blocks": [
        { "type": "spec", "settings": { "label": "Deployment", "value": "Managed by Braivex, live in your stack in weeks not quarters." } },
        { "type": "spec", "settings": { "label": "Integrations", "value": "CRM, helpdesk, calendar, telephony and data warehouse connectors." } },
        { "type": "spec", "settings": { "label": "Governance", "value": "Runtime drift monitoring, audit trails, human escalation paths." } },
        { "type": "spec", "settings": { "label": "Security", "value": "Encrypted transit and storage, data isolation, GDPR and CCPA aligned." } },
        { "type": "spec", "settings": { "label": "Channels", "value": "Voice, chat, email, SMS and WhatsApp from one agent context." } },
        { "type": "spec", "settings": { "label": "Measurement", "value": "Outcome reporting against the numbers agreed in discovery." } }
      ]
    }
  ]
}
{% endschema %}
