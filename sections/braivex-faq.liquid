{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Questions asked before signing up. Native <details>, so it works without JS. {% endcomment %}
<section class="bvx bvx--hairline-top" id="{{ section.settings.anchor | default: 'faq' }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx__head--center bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading | replace: '. ', '.<br>' }}</h2>{% endif %}
    </div>
    <div class="bvx-faq bvx-reveal">
      {% for block in section.blocks %}
        <details class="bvx-faq__item" {{ block.shopify_attributes }}>
          <summary class="bvx-faq__q"><span>{{ block.settings.q }}</span><span class="bvx-faq__mark" aria-hidden="true"></span></summary>
          <p class="bvx-faq__a">{{ block.settings.a | newline_to_br }}</p>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Braivex FAQ",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Asked before signing up." }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "textarea", "id": "a", "label": "Answer" }
    ] }
  ],
  "presets": [{ "name": "Braivex FAQ" }]
}
{% endschema %}
