{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %}
  Plan cards. One block per plan; features are one per line in the block's
  textarea. The price is text on purpose — the app's own billing page is the
  source of truth, this is the marketing copy of it.
{% endcomment %}
{% assign plans = section.blocks | where: 'type', 'plan' %}
<section class="bvx bvx--panel" id="{{ section.settings.anchor | default: 'plans' }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading | replace: '. ', '.<br>' }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede | newline_to_br }}</p>{% endif %}
    </div>

    <div class="bvx-plans bvx-reveal" style="--plan-cols: {{ plans.size | at_least: 1 | at_most: 4 }};">
      {% for block in plans %}
        <div class="bvx-plan{% if block.settings.featured %} bvx-plan--featured{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.badge != blank %}<span class="bvx-plan__badge">{{ block.settings.badge }}</span>{% endif %}
          <h3 class="bvx-plan__name">{{ block.settings.name }}</h3>
          <p class="bvx-plan__price"><b>{{ block.settings.price }}</b>{% if block.settings.period != blank %}<span>{{ block.settings.period }}</span>{% endif %}</p>
          {% if block.settings.blurb != blank %}<p class="bvx-plan__blurb">{{ block.settings.blurb | newline_to_br }}</p>{% endif %}
          {% if block.settings.features != blank %}
            <ul class="bvx-plan__list">
              {% assign lines = block.settings.features | newline_to_br | split: '<br />' %}
              {% for line in lines %}{% assign l = line | strip %}{% if l != blank %}<li>{{ l }}</li>{% endif %}{% endfor %}
            </ul>
          {% endif %}
          {% if block.settings.cta_label != blank %}
            <a class="bvx-btn {% if block.settings.featured %}bvx-btn--primary{% else %}bvx-btn--ghost{% endif %}" href="{{ block.settings.cta_link | default: '/pages/contact' }}"{% if block.settings.cta_link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.cta_label }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}<p class="bvx-plans__note bvx-reveal">{{ section.settings.note | newline_to_br }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Braivex plans",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "plans" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plans" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "textarea", "id": "note", "label": "Note under the cards", "info": "Currency, billing period, what every plan includes." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Starter" },
        { "type": "text", "id": "price", "label": "Price", "default": "$0" },
        { "type": "text", "id": "period", "label": "Period", "default": "/month" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. Most popular" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this plan", "default": false },
        { "type": "textarea", "id": "blurb", "label": "Who it is for" },
        { "type": "textarea", "id": "features", "label": "Included (one per line)" },
        { "type": "text", "id": "cta_label", "label": "Button", "default": "Start free trial" },
        { "type": "text", "id": "cta_link", "label": "Button link", "default": "/pages/contact" }
      ]
    }
  ],
  "presets": [{ "name": "Braivex plans" }]
}
{% endschema %}
