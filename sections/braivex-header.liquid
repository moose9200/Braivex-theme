{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Braivex header — sticky, transparent over the hero, parchment-free blur on scroll. {% endcomment %}
<header class="bvx-header">
  <div class="bvx-header__inner">
    <a class="bvx-header__brand" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 180 }}" alt="{{ shop.name }}" width="30" height="30" loading="eager">
      {% elsif section.settings.logo_url != blank %}
        {% comment %} Arbitrary URL, intrinsic width unknown; CSS fixes height:30px / width:auto. {% endcomment %}
        {% # theme-check-disable ImgWidthAndHeight %}
        <img class="bvx-header__logo" src="{{ section.settings.logo_url }}" alt="{{ shop.name }}" height="30" loading="eager">
        {% # theme-check-enable ImgWidthAndHeight %}
      {% endif %}
      {% if section.settings.wordmark != blank %}
        <span class="bvx-header__wordmark">{{ section.settings.wordmark }}</span>
      {% endif %}
    </a>

    {% comment %}
      Tabs come from the section's link blocks when any exist, so they can
      point at on-page anchors (Shopify's url picker cannot store "#id").
      Delete every block to fall back to the Shopify navigation menu.
    {% endcomment %}
    <nav class="bvx-nav" aria-label="Primary">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a class="bvx-nav__link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {% endfor %}
      {% else %}
        {% for link in linklists[section.settings.menu].links %}
          <a class="bvx-nav__link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    {% if section.settings.cta_label != blank %}
      <a class="bvx-btn bvx-btn--primary bvx-header__cta" {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}>{{ section.settings.cta_label }}</a>
    {% endif %}

    <button class="bvx-burger" type="button" aria-expanded="false" aria-label="Open menu">
      <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M1 1h16M1 6h16M1 11h16"/></svg>
    </button>
  </div>

  <div class="bvx-drawer">
    <nav class="bvx-drawer__nav" aria-label="Mobile">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a class="bvx-drawer__link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>{{ block.settings.label }}</a>
        {% endfor %}
      {% else %}
        {% for link in linklists[section.settings.menu].links %}
          <a class="bvx-drawer__link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>
    {% if section.settings.cta_label != blank %}
      <a class="bvx-btn bvx-btn--primary" {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}>{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</header>

{% schema %}
{
  "name": "Braivex header",
  "class": "bvx-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "text",
      "id": "logo_url",
      "label": "Logo URL",
      "info": "Used when no image is uploaded.",
      "default": "https://braivex.com/cdn/shop/files/Braivex_2.png?v=1787402023&width=400"
    },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Braivex." },
    { "type": "link_list", "id": "menu", "label": "Fallback menu", "info": "Used only when this section has no link blocks.", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start a Partnership" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Platform" },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "info": "An on-page anchor such as /#solutions scrolls smoothly. A path such as /pages/contact navigates.",
          "default": "/#solutions"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex header",
      "blocks": [
        { "type": "link", "settings": { "label": "Platform", "link": "/#solutions" } },
        { "type": "link", "settings": { "label": "Solutions", "link": "/#braivex-apps" } },
        { "type": "link", "settings": { "label": "Industries", "link": "/#industries" } },
        { "type": "link", "settings": { "label": "Insights", "link": "/#insights" } },
        { "type": "link", "settings": { "label": "Contact", "link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
