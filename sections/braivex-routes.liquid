{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Three ways in — pre-built, accelerated, tailored. {% endcomment %}
<section class="bvx bvx--hairline-top" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede }}</p>{% endif %}
    </div>

    <div class="bvx-grid bvx-grid--3 bvx-reveal">
      {% for block in section.blocks %}
        <article class="bvx-cell" {{ block.shopify_attributes }}>
          <span class="bvx-cell__index">0{{ forloop.index }}</span>
          {% if block.settings.kicker != blank %}<span class="bvx-cell__kicker">{{ block.settings.kicker }}</span>{% endif %}
          <h3 class="bvx-cell__title">{{ block.settings.title }}</h3>
          <p class="bvx-cell__desc">{{ block.settings.desc }}</p>
          {% if block.settings.link_label != blank %}
            <div class="bvx-cell__foot">
              <a class="bvx-link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>{{ block.settings.link_label }} <span class="bvx-link__arrow">&rarr;</span></a>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Braivex routes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "solutions" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three ways in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three ways to put agents to work." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Deploy what is already built, accelerate on what is half-built, or engineer what nobody else has." }
  ],
  "blocks": [
    {
      "type": "route",
      "name": "Route",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "desc", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link", "default": "/pages/contact" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex routes",
      "blocks": [
        { "type": "route", "settings": { "kicker": "Ready to deploy", "title": "Pre-built Solutions", "desc": "Banking, healthcare, retail and HR applications, live from day one.", "link_label": "Learn more" } },
        { "type": "route", "settings": { "kicker": "Fast-track build", "title": "App Accelerators", "desc": "A marketplace of pre-built agents and workflow templates to scale on.", "link_label": "Learn more" } },
        { "type": "route", "settings": { "kicker": "Custom engineering", "title": "Tailored Apps", "desc": "Applications engineered precisely to your enterprise's complexity.", "link_label": "Learn more" } }
      ]
    }
  ]
}
{% endschema %}

