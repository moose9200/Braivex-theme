{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %}
  AI Insights. Blocks are used so posts can be curated by hand; point them at
  blog articles once the Insights blog is populated.
{% endcomment %}
<section class="bvx bvx--panel" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede }}</p>{% endif %}
    </div>

    <div class="bvx-rows bvx-reveal">
      {% for block in section.blocks %}
        <a class="bvx-row" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="bvx-row__date">{{ block.settings.date }}</span>
          <span class="bvx-row__title">{{ block.settings.title }}</span>
          <span class="bvx-row__arrow">&rarr;</span>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.all_label != blank %}
      <div class="bvx-actions bvx-reveal" style="margin-top: 40px;">
        <a class="bvx-btn bvx-btn--ghost" {% if section.settings.all_link != blank %}href="{{ section.settings.all_link }}"{% endif %}>{{ section.settings.all_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Braivex insights",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "insights" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Research and discourse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "AI Insights" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Original research, product breakthroughs and strategic thinking from the Braivex engineering team." },
    { "type": "text", "id": "all_label", "label": "View all label", "default": "View All Insights" },
    { "type": "text", "id": "all_link", "label": "View all link", "default": "/blogs/news" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "text", "id": "date", "label": "Date" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "link", "label": "Link", "default": "/blogs/news" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex insights",
      "blocks": [
        { "type": "post", "settings": { "date": "18 March 2026", "title": "What's new in AI for work: the features that actually accelerate productivity" } },
        { "type": "post", "settings": { "date": "28 February 2026", "title": "Parallel agent processing: how multi-agent systems are redefining automation" } },
        { "type": "post", "settings": { "date": "10 February 2026", "title": "The AI productivity gap: why brands move faster with purpose-built agents" } },
        { "type": "post", "settings": { "date": "8 January 2026", "title": "From chatbots to agentic workflows: the evolution every leader needs to understand" } },
        { "type": "post", "settings": { "date": "5 December 2025", "title": "AI agents and the tools that make them powerful: a guide for operators" } }
      ]
    }
  ]
}
{% endschema %}

