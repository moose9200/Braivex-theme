{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %}
  Products. One full-width row per product and a closing "together" bridge —
  stacked rows rather than a tab switcher, so every product stays on the page
  and in the DOM. Each row pairs copy
  with an HTML/CSS mockup of the real UI; hovering or focusing a feature
  chip lights the matching region of the mockup (data-focus on the row,
  wired in braivex.js initProductRows). Mockups animate in through the
  shared .bvx-reveal observer and stay static under prefers-reduced-motion.
{% endcomment %}
<section class="bvx bvx--hairline-top" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading | replace: '. ', '.<br>' }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede | newline_to_br }}</p>{% endif %}
    </div>

    <div class="bvx-products">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
          <article class="bvx-product bvx-reveal{% if block.settings.reverse %} bvx-product--reverse{% endif %}"
            data-bvx-product
            {{ block.shopify_attributes }}>

            <div class="bvx-product__copy">
              {% if block.settings.kicker != blank %}<p class="bvx-cell__kicker">{{ block.settings.kicker }}</p>{% endif %}
              <h3 class="bvx-product__name">{{ block.settings.name }}{% if block.settings.badge != blank %} <span class="bvx-product__badge">{{ block.settings.badge }}</span>{% endif %}</h3>
              {% if block.settings.headline != blank %}<p class="bvx-product__headline">{{ block.settings.headline | newline_to_br }}</p>{% endif %}
              {% if block.settings.metric != blank %}
                <p class="bvx-product__metric"><span class="bvx-product__metric-dot" aria-hidden="true"></span>{{ block.settings.metric }}</p>
              {% endif %}

              {%- comment -%} Feature chips: real links into the detail page, and the hover/focus source for the mockup highlight. {%- endcomment -%}
              <ul class="bvx-product__features" aria-label="{{ block.settings.name | escape }} capabilities">
                {% for i in (1..4) %}
                  {% assign lkey = 'feature_' | append: i | append: '_label' %}
                  {% assign rkey = 'feature_' | append: i | append: '_region' %}
                  {% if block.settings[lkey] != blank %}
                    <li>
                      <a class="bvx-chip" href="{{ block.settings.page_link }}" data-region="{{ block.settings[rkey] }}">{{ block.settings[lkey] }}</a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>

              <div class="bvx-actions">
                {% if block.settings.cta_primary_label != blank %}
                  <a class="bvx-btn bvx-btn--primary" href="{{ block.settings.cta_primary_link | default: '/pages/contact' }}">{{ block.settings.cta_primary_label }}</a>
                {% endif %}
                {% if block.settings.cta_secondary_label != blank %}
                  <a class="bvx-link" href="{{ block.settings.page_link }}">{{ block.settings.cta_secondary_label }} <span class="bvx-link__arrow" aria-hidden="true">&rarr;</span></a>
                {% endif %}
              </div>
            </div>

            <div class="bvx-product__visual">
              {% case block.settings.mock %}
                {% when 'loculens' %}{% render 'product-mock-loculens', name: block.settings.name %}
                {% when 'hiresieve' %}{% render 'product-mock-hiresieve', name: block.settings.name %}
                {% when 'briefsieve' %}{% render 'product-mock-briefsieve', name: block.settings.name %}
                {% when 'homesieve' %}{% render 'product-mock-homesieve', name: block.settings.name %}
                {% when 'voicesieve' %}{% render 'product-mock-voicesieve', name: block.settings.name %}
              {% endcase %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} The bridge: what every product shares. Reads as one company. {%- endcomment -%}
    {% assign pillars = section.blocks | where: 'type', 'pillar' %}
    {% if section.settings.bridge_heading != blank or pillars.size > 0 %}
      <div class="bvx-bridge bvx-reveal">
        <div class="bvx-bridge__head">
          {% if section.settings.bridge_eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.bridge_eyebrow }}</p>{% endif %}
          {% if section.settings.bridge_heading != blank %}<h3 class="bvx-bridge__h3">{{ section.settings.bridge_heading | replace: '. ', '.<br>' }}</h3>{% endif %}
        </div>
        {% if pillars.size > 0 %}
          <ol class="bvx-bridge__pillars">
            {% for p in pillars %}
              <li class="bvx-bridge__pillar" {{ p.shopify_attributes }}>
                <span class="bvx-bridge__node" aria-hidden="true"></span>
                <span class="bvx-bridge__text">{{ p.settings.text | replace: '. ', '.<br>' }}</span>
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Braivex products",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "products" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Purpose-built products. One intelligence layer." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Purpose-built agents that live inside the systems you already run. Each one keeps a person deciding, and shows its evidence." },
    { "type": "header", "content": "Bridge" },
    { "type": "text", "id": "bridge_eyebrow", "label": "Bridge eyebrow", "default": "What they share" },
    { "type": "text", "id": "bridge_heading", "label": "Bridge heading", "default": "Different jobs. The same discipline." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "info": "Category line above the name" },
        { "type": "text", "id": "name", "label": "Product name", "default": "Product" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. In development, Early access. Blank for a live product." },
        { "type": "textarea", "id": "headline", "label": "One-line outcome" },
        { "type": "text", "id": "metric", "label": "Proof line", "info": "One real number. Leave blank rather than invent one." },
        { "type": "text", "id": "page_link", "label": "Product page", "info": "Relative path such as /pages/loculens. Feature chips and the secondary link go here." },
        {
          "type": "select",
          "id": "mock",
          "label": "Mockup",
          "options": [
            { "value": "loculens", "label": "Loculens dashboard" },
            { "value": "hiresieve", "label": "HireSieve shortlist" },
            { "value": "briefsieve", "label": "BriefSieve brief" },
            { "value": "homesieve", "label": "HomeSieve copilot" },
            { "value": "voicesieve", "label": "VoiceSieve console" }
          ],
          "default": "loculens"
        },
        { "type": "checkbox", "id": "reverse", "label": "Mockup on the left", "default": false },
        { "type": "header", "content": "Feature chips (hover lights the mockup)" },
        { "type": "text", "id": "feature_1_label", "label": "Feature 1" },
        { "type": "text", "id": "feature_1_region", "label": "Region 1", "info": "loculens: branches, sentiment, team, reply · hiresieve: evidence, score, flag, cost · briefsieve: brief, kpis, channels, guru · homesieve: ask, sources, listings, evidence · voicesieve: mine, inbound, outbound, handoff" },
        { "type": "text", "id": "feature_2_label", "label": "Feature 2" },
        { "type": "text", "id": "feature_2_region", "label": "Region 2" },
        { "type": "text", "id": "feature_3_label", "label": "Feature 3" },
        { "type": "text", "id": "feature_3_region", "label": "Region 3" },
        { "type": "text", "id": "feature_4_label", "label": "Feature 4" },
        { "type": "text", "id": "feature_4_region", "label": "Region 4" },
        { "type": "header", "content": "Calls to action" },
        { "type": "text", "id": "cta_primary_label", "label": "Primary button", "default": "Book a demo" },
        { "type": "text", "id": "cta_primary_link", "label": "Primary link", "default": "/pages/contact" },
        { "type": "text", "id": "cta_secondary_label", "label": "Secondary link text", "info": "Name the outcome, e.g. See how it reads a branch" }
      ]
    },
    {
      "type": "pillar",
      "name": "Bridge pillar",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Pillar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "kicker": "Review management · multi-location",
            "name": "Loculens",
            "headline": "Every review, every branch, one workspace — with the team members named and the reply already drafted.",
            "metric": "Live across 5 branches and 479 reviews for a national jewellery retailer",
            "page_link": "/pages/loculens",
            "mock": "loculens",
            "feature_1_label": "Branch discovery", "feature_1_region": "branches",
            "feature_2_label": "Sentiment and topics", "feature_2_region": "sentiment",
            "feature_3_label": "Team-member mentions", "feature_3_region": "team",
            "feature_4_label": "Drafted replies", "feature_4_region": "reply",
            "cta_secondary_label": "See how Loculens reads a branch"
          }
        },
        {
          "type": "product",
          "settings": {
            "kicker": "Recruitment screening · evidence-quoted",
            "name": "HireSieve",
            "headline": "A folder of CVs in, a ranked shortlist out — and every score quotes the line it came from.",
            "metric": "About 45 seconds and a few cents per CV, with the cost shown before it spends",
            "page_link": "/pages/hiresieve",
            "mock": "hiresieve",
            "reverse": true,
            "feature_1_label": "Evidence quotes", "feature_1_region": "evidence",
            "feature_2_label": "Deterministic scoring", "feature_2_region": "score",
            "feature_3_label": "Flags, never rejects", "feature_3_region": "flag",
            "feature_4_label": "Asks before it spends", "feature_4_region": "cost",
            "cta_secondary_label": "See how HireSieve scores a CV"
          }
        },
        {
          "type": "product",
          "settings": {
            "kicker": "Operator's daily brief · every channel",
            "name": "BriefSieve",
            "badge": "Early access",
            "headline": "Ads, sales, stock, email, marketplaces and inbox read for you each morning — with a guru that narrates the numbers and never computes them.",
            "metric": "Ten data sections, your own API keys, one brief",
            "page_link": "/pages/briefsieve",
            "mock": "briefsieve",
            "feature_1_label": "The morning brief", "feature_1_region": "brief",
            "feature_2_label": "KPIs, compared", "feature_2_region": "kpis",
            "feature_3_label": "Your channels, your keys", "feature_3_region": "channels",
            "feature_4_label": "Ask the guru", "feature_4_region": "guru",
            "cta_primary_label": "Request early access",
            "cta_secondary_label": "See what a brief contains"
          }
        },
        {
          "type": "product",
          "settings": {
            "kicker": "Property listings copilot · cited answers",
            "name": "HomeSieve",
            "badge": "Early access",
            "headline": "Ask the market a question in plain language. Get the listings that match, scored against your brief, each answer citing where it came from.",
            "metric": "Five live listing sources, two of them scrapers we built",
            "page_link": "/pages/homesieve",
            "mock": "homesieve",
            "reverse": true,
            "feature_1_label": "Ask in plain language", "feature_1_region": "ask",
            "feature_2_label": "Live sources", "feature_2_region": "sources",
            "feature_3_label": "Scored listings", "feature_3_region": "listings",
            "feature_4_label": "Every answer cited", "feature_4_region": "evidence",
            "cta_primary_label": "Request early access",
            "cta_secondary_label": "See how HomeSieve answers a brief"
          }
        },
        {
          "type": "product",
          "settings": {
            "kicker": "Voice agents · inbound and win-back",
            "name": "VoiceSieve",
            "badge": "In development",
            "headline": "Mines your recorded calls into a knowledge base, answers customers live from your order system, and calls lapsed customers back — declaring itself an AI in its first sentence.",
            "metric": "Specified end to end; product build starts after sign-off",
            "page_link": "/pages/voicesieve",
            "mock": "voicesieve",
            "feature_1_label": "Mined from real calls", "feature_1_region": "mine",
            "feature_2_label": "Inbound, live from Shopify", "feature_2_region": "inbound",
            "feature_3_label": "Win-back calling", "feature_3_region": "outbound",
            "feature_4_label": "Hands off when unsure", "feature_4_region": "handoff",
            "cta_primary_label": "Join the waitlist",
            "cta_secondary_label": "See how VoiceSieve handles a call"
          }
        },
        { "type": "pillar", "settings": { "text": "An AI extracts. A deterministic engine calculates. A person decides." } },
        { "type": "pillar", "settings": { "text": "Deployed into the systems you already run, under your access controls." } },
        { "type": "pillar", "settings": { "text": "Every output traceable to its source — a review, a CV line, a record." } },
        { "type": "pillar", "settings": { "text": "Priced on outcomes, not logins." } }
      ]
    }
  ]
}
{% endschema %}
