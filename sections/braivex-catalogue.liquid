{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %}
  Braivex catalogue — merges four live sections into one tabbed surface:
  pre-built solutions, tailored apps, platform capabilities, plus the
  marketplace accelerator as the closing strip.
{% endcomment %}
<section class="bvx bvx--panel bvx--hairline-top" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx-reveal">
      {% if section.settings.eyebrow != blank %}<p class="bvx__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.lede != blank %}<p class="bvx__lede">{{ section.settings.lede }}</p>{% endif %}
    </div>

    <div data-bvx-tabs="true" class="bvx-reveal">
      <div class="bvx-tabs" role="tablist" aria-label="Application catalogue">
        <button class="bvx-tab" type="button" role="tab" aria-selected="true" data-target="prebuilt">{{ section.settings.tab_1 }}</button>
        <button class="bvx-tab" type="button" role="tab" aria-selected="false" data-target="tailored">{{ section.settings.tab_2 }}</button>
        <button class="bvx-tab" type="button" role="tab" aria-selected="false" data-target="platform">{{ section.settings.tab_3 }}</button>
      </div>

      <div class="bvx-panel" data-panel="prebuilt" data-active="true" role="tabpanel">
        <div class="bvx-grid bvx-grid--3">
          {% for block in section.blocks %}
            {% if block.settings.group == 'prebuilt' %}
              <article class="bvx-cell" {{ block.shopify_attributes }}>
                {% if block.settings.kicker != blank %}<span class="bvx-cell__kicker">{{ block.settings.kicker }}</span>{% endif %}
                <h3 class="bvx-cell__title">{{ block.settings.title }}</h3>
                <p class="bvx-cell__desc">{{ block.settings.desc }}</p>
                {% if block.settings.link_label != blank %}
                  <div class="bvx-cell__foot"><a class="bvx-link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>{{ block.settings.link_label }} <span class="bvx-link__arrow">&rarr;</span></a></div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="bvx-panel" data-panel="tailored" data-active="false" role="tabpanel">
        <div class="bvx-grid bvx-grid--3">
          {% for block in section.blocks %}
            {% if block.settings.group == 'tailored' %}
              <article class="bvx-cell" {{ block.shopify_attributes }}>
                {% if block.settings.kicker != blank %}<span class="bvx-cell__kicker">{{ block.settings.kicker }}</span>{% endif %}
                <h3 class="bvx-cell__title">{{ block.settings.title }}</h3>
                <p class="bvx-cell__desc">{{ block.settings.desc }}</p>
                {% if block.settings.link_label != blank %}
                  <div class="bvx-cell__foot"><a class="bvx-link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>{{ block.settings.link_label }} <span class="bvx-link__arrow">&rarr;</span></a></div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="bvx-panel" data-panel="platform" data-active="false" role="tabpanel">
        <div class="bvx-grid bvx-grid--3">
          {% for block in section.blocks %}
            {% if block.settings.group == 'platform' %}
              <article class="bvx-cell" {{ block.shopify_attributes }}>
                {% if block.settings.kicker != blank %}<span class="bvx-cell__kicker">{{ block.settings.kicker }}</span>{% endif %}
                <h3 class="bvx-cell__title">{{ block.settings.title }}</h3>
                <p class="bvx-cell__desc">{{ block.settings.desc }}</p>
                {% if block.settings.meta != blank %}<span class="bvx-cell__meta">{{ block.settings.meta }}</span>{% endif %}
                {% if block.settings.link_label != blank %}
                  <div class="bvx-cell__foot"><a class="bvx-link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>{{ block.settings.link_label }} <span class="bvx-link__arrow">&rarr;</span></a></div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.strip_heading != blank %}
      <div class="bvx-quote {% if section.settings.strip_face %}bvx-quote--split{% endif %} bvx-reveal" style="margin-top: 72px;">
        <div class="bvx-quote__copy">
        {% if section.settings.strip_eyebrow != blank %}<p class="bvx__eyebrow" style="margin-bottom: 18px;">{{ section.settings.strip_eyebrow }}</p>{% endif %}
        <p class="bvx-quote__text">{{ section.settings.strip_heading }}</p>
        {% if section.settings.strip_body != blank %}<p class="bvx__lede" style="max-width: 62ch; margin-bottom: 26px;">{{ section.settings.strip_body }}</p>{% endif %}
        {% if section.settings.strip_cta_1_label != blank %}
          <div class="bvx-actions">
            <a class="bvx-btn bvx-btn--primary" {% if section.settings.strip_cta_1_link != blank %}href="{{ section.settings.strip_cta_1_link }}"{% endif %}>{{ section.settings.strip_cta_1_label }}</a>
            {% if section.settings.strip_cta_2_label != blank %}
              <a class="bvx-btn bvx-btn--ghost" {% if section.settings.strip_cta_2_link != blank %}href="{{ section.settings.strip_cta_2_link }}"{% endif %}>{{ section.settings.strip_cta_2_label }}</a>
            {% endif %}
          </div>
        {% endif %}
        </div>
        {% if section.settings.strip_face %}
          {% render 'floating-elements', type: 'face' %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Braivex catalogue",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "braivex-apps" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What you can deploy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pre-built, tailored, or built on the platform." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Regulation-aware applications with no long implementation cycles and no starting from scratch." },
    { "type": "text", "id": "tab_1", "label": "Tab 1 label", "default": "Pre-built solutions" },
    { "type": "text", "id": "tab_2", "label": "Tab 2 label", "default": "Tailored apps" },
    { "type": "text", "id": "tab_3", "label": "Tab 3 label", "default": "Platform capabilities" },
    { "type": "header", "content": "Marketplace strip" },
    { "type": "text", "id": "strip_eyebrow", "label": "Eyebrow", "default": "Marketplace accelerator" },
    { "type": "checkbox", "id": "strip_face", "label": "Contour-face animation", "info": "Interactive wireframe head beside the strip copy.", "default": true },
    { "type": "textarea", "id": "strip_heading", "label": "Heading", "default": "Build agentic AI applications 10x faster." },
    { "type": "textarea", "id": "strip_body", "label": "Body", "default": "Hundreds of pre-built agents, workflow templates and integrations trusted by global enterprises. Skip the boilerplate, ship the outcome." },
    { "type": "text", "id": "strip_cta_1_label", "label": "Primary button", "default": "Secure Early Access" },
    { "type": "url", "id": "strip_cta_1_link", "label": "Primary link", "default": "/pages/contact" },
    { "type": "text", "id": "strip_cta_2_label", "label": "Secondary button", "default": "Explore Library" },
    { "type": "url", "id": "strip_cta_2_link", "label": "Secondary link", "default": "/pages/marketplace" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Application",
      "settings": [
        { "type": "select", "id": "group", "label": "Tab", "options": [ { "value": "prebuilt", "label": "Pre-built solutions" }, { "value": "tailored", "label": "Tailored apps" }, { "value": "platform", "label": "Platform capabilities" } ], "default": "prebuilt" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "desc", "label": "Description" },
        { "type": "text", "id": "meta", "label": "Meta line" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link", "default": "/pages/contact" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex catalogue",
      "blocks": [
        { "type": "item", "settings": { "group": "prebuilt", "kicker": "Enterprise bundle", "title": "Supply Chain Intelligence", "desc": "Global logistics streamlined with predictive neural routing.", "link_label": "View module" } },
        { "type": "item", "settings": { "group": "prebuilt", "kicker": "Enterprise bundle", "title": "Autonomous Customer Ops", "desc": "End-to-end customer resolution without human intervention.", "link_label": "View module" } },
        { "type": "item", "settings": { "group": "prebuilt", "kicker": "Enterprise bundle", "title": "Regulatory Compliance Agent", "desc": "Automated audit trails and real-time regulatory alignment.", "link_label": "View module" } },
        { "type": "item", "settings": { "group": "prebuilt", "kicker": "Enterprise bundle", "title": "Neural Process Optimizer", "desc": "Process bottlenecks found and resolved before they touch margin.", "link_label": "View module" } },
        { "type": "item", "settings": { "group": "prebuilt", "kicker": "Enterprise bundle", "title": "Executive Data Synthesis", "desc": "Instant C-suite reporting from disparate enterprise sources.", "link_label": "View module" } },
        { "type": "item", "settings": { "group": "prebuilt", "kicker": "Enterprise bundle", "title": "Real-time Fraud Shield", "desc": "Sophisticated fraud stopped by sub-second neural analysis.", "link_label": "View module" } },
        { "type": "item", "settings": { "group": "tailored", "kicker": "Ready to build", "title": "Custom CRM Integrator", "desc": "Your existing CRM deep-linked with agentic routing logic.", "link_label": "Contact for custom build" } },
        { "type": "item", "settings": { "group": "tailored", "kicker": "Ready to build", "title": "Financial Data Synthesizer", "desc": "Unified financial reporting with AI-driven insight on top.", "link_label": "Contact for custom build" } },
        { "type": "item", "settings": { "group": "tailored", "kicker": "Ready to build", "title": "HR Voice Assistant", "desc": "Multilingual voice interface for hands-free employee self-service.", "link_label": "Contact for custom build" } },
        { "type": "item", "settings": { "group": "platform", "kicker": "Core capability", "title": "Neural Routing Fabric", "desc": "Low-latency dispatch of intent to the agent best equipped to handle it.", "meta": "Enterprise general release", "link_label": "Full spec sheet" } },
        { "type": "item", "settings": { "group": "platform", "kicker": "Core capability", "title": "SafeConnect Gateway", "desc": "Encrypted transit for all PII and sensitive data passing through AI.", "meta": "Enterprise general release", "link_label": "Full spec sheet" } },
        { "type": "item", "settings": { "group": "platform", "kicker": "Core capability", "title": "Real-time Synthesis Engine", "desc": "Disparate sources consolidated into coherent natural language.", "meta": "Enterprise general release", "link_label": "Full spec sheet" } },
        { "type": "item", "settings": { "group": "platform", "kicker": "Core capability", "title": "Governance & Drift Monitor", "desc": "Continuous runtime monitoring for hallucination and voice drift.", "meta": "Enterprise general release", "link_label": "Full spec sheet" } },
        { "type": "item", "settings": { "group": "platform", "kicker": "Core capability", "title": "Agent Orchestration", "desc": "Multi-agent coordination for multi-step business resolution.", "meta": "Enterprise general release", "link_label": "Full spec sheet" } },
        { "type": "item", "settings": { "group": "platform", "kicker": "Core capability", "title": "Distributed Context Memory", "desc": "Persistent encrypted memory that holds context across touchpoints.", "meta": "Enterprise general release", "link_label": "Full spec sheet" } }
      ]
    }
  ]
}
{% endschema %}

