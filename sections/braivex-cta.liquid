{{ 'braivex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'braivex.js' | asset_url }}" defer="defer"></script>

{% comment %} Dual final CTA — high touch versus self-service. {% endcomment %}
<section class="bvx bvx--hairline-top" id="{{ section.settings.anchor }}">
  <div class="bvx__inner">
    <div class="bvx__head bvx__head--center bvx-reveal">
      {% if section.settings.heading != blank %}<h2 class="bvx__h2">{{ section.settings.heading }}</h2>{% endif %}
    </div>

    <div class="bvx-dual bvx-reveal">
      {% for block in section.blocks %}
        <div class="bvx-dual__panel" {{ block.shopify_attributes }}>
          {% if block.settings.kicker != blank %}<span class="bvx-cell__kicker">{{ block.settings.kicker }}</span>{% endif %}
          <h3 class="bvx-cell__title" style="font-size: 2.4rem;">{{ block.settings.title }}</h3>
          <p class="bvx-cell__desc">{{ block.settings.desc }}</p>
          {% if block.settings.link_label != blank %}
            <div class="bvx-actions">
              <a class="bvx-btn {% if forloop.index == 1 %}bvx-btn--primary{% else %}bvx-btn--ghost{% endif %}" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>{{ block.settings.link_label }}</a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Braivex final CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "get-started" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Accelerate your business with AI that actually delivers." }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Path",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "desc", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link", "default": "/pages/contact" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braivex final CTA",
      "blocks": [
        { "type": "path", "settings": { "kicker": "High touch", "title": "Ready to see Braivex in action?", "desc": "Talk to an AI specialist and see exactly how agentic AI changes your operations.", "link_label": "Schedule a Deep Dive" } },
        { "type": "path", "settings": { "kicker": "Self-service", "title": "Want to start immediately?", "desc": "Browse the marketplace and deploy production-ready agents in minutes.", "link_label": "Explore the Marketplace" } }
      ]
    }
  ]
}
{% endschema %}

