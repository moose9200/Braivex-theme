{% comment %}
  snippets/product-mock-housieve.liquid
  HTML/CSS mockup of the Housieve feed. Decorative: the addresses, prices and
  scores are invented sample data, the way the product's own landing page
  labels its demo stream. What it shows is real — one search across the five
  portals it reads, a 0 to 100 score on every listing, and a watch profile
  that alerts by email and WhatsApp. Regions carry data-mock-region for the
  chip highlight.
  Usage: {% render 'product-mock-housieve', name: 'Housieve' %}
{% endcomment %}
<div class="bvx-mock bvx-mock--housieve" role="img" aria-label="{{ name | default: 'Housieve' }} feed: a question typed in plain words, the five portals it reads, three matching homes scored 0 to 100, and the alert a watch profile sends">
  <div class="bvx-mock__bar" aria-hidden="true">
    <span class="bvx-mock__dot"></span><span class="bvx-mock__dot"></span><span class="bvx-mock__dot"></span>
    <span class="bvx-mock__title">{{ name | default: 'Housieve' }} · London · Buy</span>
  </div>

  <div class="bvx-mock__body" aria-hidden="true">
    <div class="bvx-mock__region bvx-mock__card bvx-mock__chat" data-mock-region="ask">
      <p class="bvx-mock__q">2-bed under £600k in SW3, quiet street, walk to a tube.</p>
      <p class="bvx-mock__a">Eight match today and three score above 70. The strongest is 12 Carlyle Square, listed this morning at £585k, 1,140 sq ft, two minutes from South Kensington. <em>Scored on yield, location, condition and growth.</em></p>
    </div>

    <div class="bvx-mock__region bvx-mock__channels" data-mock-region="sources">
      <span class="bvx-mock__label">Five portals · read overnight · scored by morning</span>
      <div class="bvx-mock__chips">
        <span class="bvx-mock__chip">Rightmove</span>
        <span class="bvx-mock__chip">Zoopla</span>
        <span class="bvx-mock__chip">OnTheMarket</span>
        <span class="bvx-mock__chip">Gumtree</span>
        <span class="bvx-mock__chip">Nestoria</span>
      </div>
    </div>

    <ol class="bvx-mock__region bvx-mock__listings" data-mock-region="listings">
      <li class="bvx-mock__listing">
        <span class="bvx-mock__photo bvx-mock__photo--a"></span>
        <span class="bvx-mock__listing-name">12 Carlyle Square, SW3</span>
        <span class="bvx-mock__listing-meta">£585k · 2 bed · 1,140 sq ft · new today</span>
        <span class="bvx-mock__score"><i class="bvx-mock__fill" style="--w:92%"></i><b>92</b></span>
      </li>
      <li class="bvx-mock__listing">
        <span class="bvx-mock__photo bvx-mock__photo--b"></span>
        <span class="bvx-mock__listing-name">221 Upper Street, N1</span>
        <span class="bvx-mock__listing-meta">£560k · 2 bed · 1,050 sq ft · price cut £15k</span>
        <span class="bvx-mock__score"><i class="bvx-mock__fill" style="--w:78%"></i><b>78</b></span>
      </li>
      <li class="bvx-mock__listing">
        <span class="bvx-mock__photo bvx-mock__photo--c"></span>
        <span class="bvx-mock__listing-name">9 Rivington Street, EC2</span>
        <span class="bvx-mock__listing-meta">£599k · 1 bed · 720 sq ft · 41 days listed</span>
        <span class="bvx-mock__score"><i class="bvx-mock__fill" style="--w:64%"></i><b>64</b></span>
      </li>
    </ol>

    <div class="bvx-mock__region bvx-mock__cite" data-mock-region="alert">
      <span class="bvx-mock__reply-tag">Alert</span>
      <span class="bvx-mock__cite-text">Watch profile "SW3 · 2 bed · under £600k" matched 12 Carlyle Square 40 seconds ago · sent by email and WhatsApp with the score, the map pin and <b>a link to the original listing</b></span>
    </div>
  </div>
</div>
